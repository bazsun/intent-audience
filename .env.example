# Database Configuration
DATABASE_URL=postgresql://intent_user:intent_pass@localhost:5432/intent_audience
MONGODB_URL=mongodb://intent_user:intent_pass@localhost:27017/intent_audience
REDIS_URL=redis://localhost:6379/0

# ML Configuration  
MODEL_STORAGE_PATH=data/models/
FEATURE_STORE_PATH=data/features/
ML_WORKER_COUNT=4

# API Configuration
API_SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO

# Performance Settings
MAX_CUSTOMERS_PER_REQUEST=100000
AUDIENCE_GENERATION_TIMEOUT=300
CACHE_TTL_SECONDS=3600

# Privacy Settings
ENABLE_PII_HASHING=true
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true